// Prisma Schema for Appreciate
// Connects to Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User profile with auth credentials
model Profile {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String?  @db.VarChar(255)
  name      String
  avatarUrl String?  @map("avatar_url") @db.VarChar(500)
  provider  String   @default("email") @db.VarChar(20) // email | google | apple
  googleId  String?  @unique @map("google_id")
  appleId   String?  @unique @map("apple_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  posts     GratitudePost[]
  streak    StreakData?
  hearts    Heart[]

  @@map("profiles")
}

// Gratitude posts
model GratitudePost {
  id         String         @id @default(uuid()) @db.Uuid
  content    String         @db.Text
  feeling    String?        @db.VarChar(200)
  category   Category       @default(OTHER)
  visibility PostVisibility @default(PUBLIC)
  photoUrl   String?        @map("photo_url") @db.VarChar(500)
  authorId   String         @map("author_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  heartCount Int            @default(0) @map("heart_count")

  author Profile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  hearts Heart[]

  @@index([authorId])
  @@index([createdAt(sort: Desc)])
  @@index([category])
  @@map("gratitude_posts")
}

// Streak tracking
model StreakData {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  currentStreak Int      @default(0) @map("current_streak")
  longestStreak Int      @default(0) @map("longest_streak")
  lastPostDate DateTime? @map("last_post_date") @db.Date
  totalPosts    Int      @default(0) @map("total_posts")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streak_data")
}

// Hearts (likes)
model Heart {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  post  GratitudePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user  Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId]) // Prevent duplicate hearts
  @@index([postId])
  @@index([userId])
  @@map("hearts")
}

// Enums
enum Category {
  FAMILY
  WORK
  SMALL_JOYS
  NATURE
  HEALTH
  OTHER

  @@map("gratitude_category")
}

enum PostVisibility {
  PRIVATE
  PUBLIC
  ANONYMOUS

  @@map("post_visibility")
}
